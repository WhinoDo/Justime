# 前端环境变量配置
# 复制此文件为 .env.local 并填写实际值

# 后端服务地址配置（浏览器、默认服务端代理均可用）
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8080

# 可选：仅服务端 API 路由使用的后端地址（覆盖 NEXT_PUBLIC_*，适合 Docker 内 Next 访问宿主机后端）
# BACKEND_URL=http://host.docker.internal:8080

# 前端应用配置
NEXT_PUBLIC_APP_NAME=Justime 智能助手
NEXT_PUBLIC_APP_VERSION=1.0.0

# JWT 密钥配置 (用于验证token)
JWT_SECRET=your-secret-key-here-change-in-production

# 其他前端配置...
# 注意：不要在此处添加后端API密钥等敏感信息
# 所有后端相关的配置都应该在justime_backend的.env文件中设置