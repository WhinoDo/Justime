# ==============================================================================
# Justime Homelab 环境配置模板
# ==============================================================================
#
# ⚠️  安全警告：部署前必须替换所有占位符！
#
# 以下占位符必须替换为实际值：
#   - replace-with-your-tailnet-host  → 您的 Tailscale 域名 (如: myserver.tail12345.ts.net)
#   - replace-with-a-long-random-string → JWT 密钥 (运行: openssl rand -hex 32)
#   - replace-with-a-second-long-random-string → JWT 刷新密钥 (运行: openssl rand -hex 32)
#   - replace-with-a-password-reset-secret → JWT 密码重置密钥 (运行: openssl rand -hex 32)
#   - replace-with-an-encryption-secret → 加密密钥 (运行: openssl rand -hex 32)
#   - replace-with-a-csrf-secret → CSRF 密钥 (运行: openssl rand -hex 32)
#   - replace-with-a-random-openclaw-token → OpenClaw 网关令牌 (运行: openssl rand -hex 16)
#   - replace-with-mongo-root-password → MongoDB root 密码 (运行: openssl rand -hex 32)
#   - replace-with-mongo-app-password → MongoDB 应用密码 (运行: openssl rand -hex 32)
#
# 使用方法:
#   1. 复制此文件: cp .env.example .env
#   2. 替换所有占位符为实际值
#   3. 根据实际环境调整其他配置
#
# ==============================================================================

COMPOSE_PROJECT_NAME=justime-homelab
JUSTIME_REPO_ROOT=/Users/zhuyuxuan/Desktop/Code/justime
TAILSCALE_SERVE_HOST=
CADDY_HTTP_PORT=8088

# Frontend / Next.js
NEXT_PUBLIC_APP_NAME=Justime 智能助手
NEXT_PUBLIC_APP_VERSION=1.0.0

# ⚠️ 必须替换: 您的 Tailscale 域名或公网域名
NEXTAUTH_URL=https://replace-with-your-tailnet-host

NEXT_PUBLIC_BACKEND_URL=/backend
BACKEND_INTERNAL_URL=http://backend:8080

# MongoDB 认证配置
MONGODB_DB_NAME=justime-agent

# ⚠️ 必须替换: MongoDB root 用户密码 (openssl rand -hex 32)
MONGO_ROOT_PASSWORD=replace-with-mongo-root-password

# ⚠️ 必须替换: MongoDB 应用用户密码 (openssl rand -hex 32)
MONGO_APP_PASSWORD=replace-with-mongo-app-password

# MongoDB 连接 URI (已启用认证)
# 格式: mongodb://用户名:密码@主机:端口/数据库?authSource=认证数据库
MONGODB_URI=mongodb://justime_app:${MONGO_APP_PASSWORD}@mongodb:27017/justime-agent?authSource=justime-agent

# ⚠️ 必须替换: JWT 签名密钥 (openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-string

# Backend / FastAPI
HOST=0.0.0.0
PORT=8080
DEBUG=false
REDIS_URL=redis://redis:6379/0

# ⚠️ 必须替换: JWT 刷新密钥 (openssl rand -hex 32)
JWT_REFRESH_SECRET=replace-with-a-second-long-random-string

# ⚠️ 必须替换: JWT 密码重置密钥 (openssl rand -hex 32)
JWT_PASSWORD_RESET_SECRET=replace-with-a-password-reset-secret

# ⚠️ 必须替换: 加密密钥 (openssl rand -hex 32)
ENCRYPTION_SECRET=replace-with-an-encryption-secret

# ⚠️ 必须替换: CSRF 密钥 (openssl rand -hex 32)
CSRF_SECRET=replace-with-a-csrf-secret

ROUTER_ENABLED=true
ENABLE_ROUTING_META=true

# Existing backend integrations (fill as needed)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
FEISHU_CLIENT_ID=
FEISHU_CLIENT_SECRET=
NOTEBOOKLM_CLI_PATH=notebooklm

# Cloud RAG / NotebookLM 云端知识库配置
# 已移除本地 LlamaIndex/HuggingFace/向量数据库依赖
# ==============================================================================
# 【废弃迁移说明】
# 旧本地 RAG 变量 (RAG_EMBED_MODEL, RAG_LLM_API_BASE, RAG_CHUNK_* 等) 已移除。
# 请使用 RAG_PROVIDER=notebooklm 通过 Google NotebookLM 实现云端 RAG。
# ==============================================================================
RAG_PROVIDER=notebooklm
NOTEBOOKLM_ENABLED=false
NOTEBOOKLM_STORAGE_PATH=
NOTEBOOKLM_PROFILE=
NOTEBOOKLM_AUTH_JSON=

# OpenClaw special-task route
OPENCLAW_ENABLED=true
OPENCLAW_TIMEOUT_SECONDS=180
OPENCLAW_SESSION_PREFIX=justime

# ⚠️ 必须替换: OpenClaw 网关令牌 (openssl rand -hex 16)
OPENCLAW_GATEWAY_TOKEN=replace-with-a-random-openclaw-token

MINIMAX_API_KEY=

# OpenClaw standalone gateway service
OPENCLAW_STATE_DIR=/var/lib/openclaw
OPENCLAW_CONFIG_PATH=/var/lib/openclaw/openclaw.json
