COMPOSE_PROJECT_NAME=jushi-homelab
JUSHI_REPO_ROOT=/Users/zhuyuxuan/Desktop/Code/jushi
TAILSCALE_SERVE_HOST=
CADDY_HTTP_PORT=8088

# Frontend / Next.js
NEXT_PUBLIC_APP_NAME=聚石智能助手
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXTAUTH_URL=https://replace-with-your-tailnet-host
NEXT_PUBLIC_BACKEND_URL=/backend
BACKEND_INTERNAL_URL=http://backend:8080
MONGODB_URI=mongodb://mongodb:27017/jushi-agent
JWT_SECRET=replace-with-a-long-random-string

# Backend / FastAPI
HOST=0.0.0.0
PORT=8080
DEBUG=false
MONGODB_DB_NAME=jushi-agent
REDIS_URL=redis://redis:6379/0
JWT_REFRESH_SECRET=replace-with-a-second-long-random-string
ROUTER_ENABLED=true
ENABLE_ROUTING_META=true

# Existing backend integrations (fill as needed)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
FEISHU_CLIENT_ID=
FEISHU_CLIENT_SECRET=
NOTEBOOKLM_CLI_PATH=notebooklm

# OpenClaw special-task route
OPENCLAW_ENABLED=true
OPENCLAW_TIMEOUT_SECONDS=180
OPENCLAW_SESSION_PREFIX=jushi
OPENCLAW_GATEWAY_TOKEN=replace-with-a-random-openclaw-token
MINIMAX_API_KEY=

# OpenClaw standalone gateway service
OPENCLAW_STATE_DIR=/var/lib/openclaw
OPENCLAW_CONFIG_PATH=/var/lib/openclaw/openclaw.json
