# ==============================================================================
# Jushi Gateway Configuration (Production HTTPS)
# ==============================================================================
#
# This is a production-ready Caddyfile with automatic HTTPS enabled.
# Caddy will automatically obtain and renew Let's Encrypt certificates.
#
# Usage:
#   1. Copy this file to Caddyfile: cp Caddyfile.https Caddyfile
#   2. Replace YOUR_DOMAIN with your actual domain
#   3. Ensure DNS is properly configured to point to your server
#   4. Ensure ports 80 and 443 are open in your firewall
#   5. Restart Caddy: docker compose restart gateway
#
# Requirements:
#   - Valid domain name with DNS pointing to this server
#   - Ports 80 and 443 accessible from the internet
#   - Email for Let's Encrypt notifications (optional but recommended)
#
# ==============================================================================

{
  # Automatic HTTPS enabled (default behavior)
  # Caddy will obtain certificates from Let's Encrypt automatically
  email admin@YOUR_DOMAIN
}

YOUR_DOMAIN {
  log {
    output file /var/log/caddy/access.log
    format console
  }

  encode zstd gzip

  # Security headers for all responses
  header {
    # Prevent clickjacking
    X-Frame-Options "DENY"
    # Prevent MIME-type sniffing
    X-Content-Type-Options "nosniff"
    # Enable XSS filter in browsers
    X-XSS-Protection "1; mode=block"
    # Content Security Policy - restrict to same origin
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'none';"
    # Referrer Policy
    Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions Policy
    Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    # HTTP Strict Transport Security (HSTS) - 1 year
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # Remove server identification
    -Server
  }

  handle_path /healthz {
    respond "ok" 200
  }

  handle_path /backend/* {
    reverse_proxy backend:8080
  }

  handle_path /openclaw/* {
    reverse_proxy openclaw:18789
  }

  handle {
    reverse_proxy frontend:3000
  }
}

# Redirect www to non-www (optional)
www.YOUR_DOMAIN {
  redir https://YOUR_DOMAIN{uri} permanent
}
