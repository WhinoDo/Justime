{
  auto_https off
  admin off
}

:80 {
  log {
    output file /var/log/caddy/access.log
    format console
  }

  encode zstd gzip

  handle_path /healthz {
    respond "ok" 200
  }

  handle_path /backend/* {
    reverse_proxy backend:8080
  }

  handle_path /openclaw/* {
    reverse_proxy openclaw:18789
  }

  handle {
    reverse_proxy frontend:3000
  }
}
