# 安全配置 (生成新密钥: openssl rand -hex 32)
# 注意: JWT_SECRET, JWT_REFRESH_SECRET, ENCRYPTION_SECRET 必须至少 32 字符
JWT_SECRET=your_jwt_secret_here_at_least_32_characters
JWT_REFRESH_SECRET=your_refresh_secret_here_at_least_32_characters
JWT_PASSWORD_RESET_SECRET=your_password_reset_secret_here_at_least_32_characters
ENCRYPTION_SECRET=your_encryption_secret_here_at_least_32_characters

# CSRF 防护配置
CSRF_ENABLED=true
CSRF_SECRET=your_csrf_secret_here

# MongoDB配置
MONGODB_URI=mongodb://localhost:27017/justime-agent
MONGODB_DB_NAME=justime-agent
# 仅本地单机 MongoDB 推荐 True；副本集/生产集群必须保持 False
MONGODB_DIRECT_CONNECTION=False
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=0

# MongoDB 连接池配置
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_IDLE_TIME_MS=60000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=30000

# MongoDB Read Preference 配置
# 可选值: primary, primaryPreferred, secondary, secondaryPreferred, nearest
MONGODB_READ_PREFERENCE=primary

# Redis 配置 (可选，用于缓存和异步任务状态)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# 文件上传配置
MAX_FILE_SIZE=52428800
CHUNKED_UPLOAD_THRESHOLD=10485760
CHUNK_SIZE=1048576

# 服务器配置
HOST=0.0.0.0
PORT=8080
DEBUG=False

# LLM配置
LLM_DEFAULT_PROVIDER=openai
LLM_API_KEY=sk-your-api-key
LLM_MODEL_ID=gpt-3.5-turbo
LLM_BASE_URL=https://api.openai.com/v1

# 多 LLM 配置示例
LLM_PROVIDERS='[{"name":"openai","model_id":"gpt-4","api_key":"sk-xxx"}]'

# 路由与混合模型配置
ROUTER_ENABLED=true
ROUTER_CLASSIFIER_TIMEOUT_SECONDS=8
ROUTER_MAIN_TIMEOUT_SECONDS=22
ROUTER_FALLBACK_TIMEOUT_SECONDS=35
ENABLE_PARALLEL_ENSEMBLE=false
ENABLE_ROUTING_META=true

# YouTube 资源解析配置
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI API Key (用于 update_system_key.py 脚本更新 GPT-4o 密钥)
OPENAI_API_KEY=sk-your-openai-key
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_ASR_TIMEOUT_SECONDS=900
ALIYUN_AK_ID=your-ak-id-for-nls-token
ALIYUN_AK_SECRET=your-ak-secret-for-nls-token
ALIYUN_NLS_REGION_ID=cn-shanghai
ALIYUN_NLS_DOMAIN=nls-meta.cn-shanghai.aliyuncs.com
ALIYUN_NLS_API_VERSION=2019-02-28
ALIYUN_NLS_ACTION=CreateToken
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=your-private-bucket
ALIYUN_OSS_ACCESS_KEY_ID=your-oss-ak
ALIYUN_OSS_ACCESS_KEY_SECRET=your-oss-sk
ALIYUN_OSS_PREFIX=youtube-summary-temp
ALIYUN_OSS_SIGNED_URL_EXPIRES_SECONDS=3600
YOUTUBE_SUMMARY_OUTPUT_DIR=output/youtube_summaries
YOUTUBE_JOB_TIMEOUT_SECONDS=7200

# NotebookLM 配置 (Google NotebookLM 云端 RAG)
# 启用后知识库问答将走 Google NotebookLM，需先运行 `notebooklm login` 获取认证
NOTEBOOKLM_ENABLED=false
# 可选：指定 storage_state.json 路径（默认 ~/.notebooklm/）
NOTEBOOKLM_STORAGE_PATH=
# 可选：指定 Google 账号 profile 名称（默认 default）
NOTEBOOKLM_PROFILE=
