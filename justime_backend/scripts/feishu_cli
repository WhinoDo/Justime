#!/usr/bin/env bash
# 飞书 CLI 入口脚本
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# 优先查找顺序：
# 1. 活跃的虚拟环境 VIRTUAL_ENV
# 2. ../.venv (标准)
# 3. ../venv (标准)
# 4. ../.venv312 (历史兼容)
# 5. ../.venv_runtime (历史兼容)
# 6. 系统 python3

VENV_PYTHON=""

if [ -n "$VIRTUAL_ENV" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
    VENV_PYTHON="$VIRTUAL_ENV/bin/python"
elif [ -x "${SCRIPT_DIR}/../.venv/bin/python" ]; then
    VENV_PYTHON="${SCRIPT_DIR}/../.venv/bin/python"
elif [ -x "${SCRIPT_DIR}/../venv/bin/python" ]; then
    VENV_PYTHON="${SCRIPT_DIR}/../venv/bin/python"
elif [ -x "${SCRIPT_DIR}/../.venv312/bin/python" ]; then
    VENV_PYTHON="${SCRIPT_DIR}/../.venv312/bin/python"
elif [ -x "${SCRIPT_DIR}/../.venv_runtime/bin/python" ]; then
    VENV_PYTHON="${SCRIPT_DIR}/../.venv_runtime/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    VENV_PYTHON="$(command -v python3)"
fi

if [ -z "$VENV_PYTHON" ]; then
    echo "feishu_cli: no python executable found" >&2
    exit 1
fi

exec "$VENV_PYTHON" -m cli.feishu_cli "$@"
