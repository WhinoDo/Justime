#!/usr/bin/env bash
# 飞书 CLI 入口脚本
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VENV_PYTHON="${SCRIPT_DIR}/../.venv312/bin/python"
if [ ! -x "$VENV_PYTHON" ]; then
    VENV_PYTHON="${SCRIPT_DIR}/../.venv_runtime/bin/python"
fi
if [ ! -x "$VENV_PYTHON" ]; then
    echo "feishu_cli: no venv python found" >&2
    exit 1
fi
exec "$VENV_PYTHON" -m cli.feishu_cli "$@"
