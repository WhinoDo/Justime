# 前端环境变量配置
# 复制此文件为 .env.local 并填写实际值

# 后端服务地址配置
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8080

# 前端应用配置
NEXT_PUBLIC_APP_NAME=聚石智能助手
NEXT_PUBLIC_APP_VERSION=1.0.0

# MongoDB 数据库配置
MONGODB_URI=mongodb://localhost:27017/jushi_agent

# JWT 密钥配置
JWT_SECRET=your-secret-key-here-change-in-production

# 其他前端配置...
# 注意：不要在此处添加后端API密钥等敏感信息
# 所有后端相关的配置都应该在jushi_backend的.env文件中设置