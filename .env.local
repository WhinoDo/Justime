# MongoDB数据库配置
MONGODB_URI=mongodb://localhost:27017/jushi-agent

# NextAuth配置
NEXTAUTH_URL=http://192.168.1.4:3000
NEXTAUTH_SECRET=your-secret-key-here

# 飞书应用配置
FEISHU_CLIENT_ID=your_app_id
FEISHU_CLIENT_SECRET=your_app_secret
FEISHU_REDIRECT_URI=http://192.168.1.4:3000/feishu/bind-callback
FEISHU_QR_REDIRECT_URI=http://192.168.1.4:3000/api/feishu/qr-login/callback

# 应用基础URL
NEXT_PUBLIC_APP_URL=http://192.168.1.4:3000

# Supabase配置（如果需要）
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI服务配置
SILICONFLOW_API_KEY=your_siliconflow_api_key
