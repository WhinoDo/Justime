# Justime Mobile Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files with real URLs or credentials

# =============================================================================
# API Configuration
# =============================================================================

# Base URL for the backend API
# Development (local): http://127.0.0.1:8080
# Staging: https://staging-api.justime.app
# Production: https://api.justime.app
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080

# Allow manual API base URL input in the app (useful for development)
# Set to false in production to lock the API URL
EXPO_PUBLIC_ALLOW_MANUAL_API_BASE_URL=true

# =============================================================================
# Environment Mode
# =============================================================================

# Current environment: development | staging | production
# This affects logging, error handling, and feature flags
EXPO_PUBLIC_ENV=development

# =============================================================================
# Feature Flags (optional)
# =============================================================================

# Enable debug logging
EXPO_PUBLIC_DEBUG=true

# Enable analytics (set to true in production)
EXPO_PUBLIC_ANALYTICS_ENABLED=false
